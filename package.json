{
  "name": "dnex-ponto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DNEX Ponto — Sistema de Ponto Eletrônico mobile-first, offline-first, com integração nativa ao DNEX Folha.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:ds": "node scripts/ds-snapshot.mjs verify && node scripts/workspace-shell-snapshot.mjs verify && pnpm --dir packages/dnex-design-system build:library && pnpm --dir packages/dnex-contracts build && pnpm --dir packages/dnex-workspace-shell build",
    "dev": "pnpm prepare:ds && vite",
    "build": "pnpm prepare:ds && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm prepare:ds && tsc -b --noEmit",
    "build:module": "vite build --config vite.module.config.ts"
  },
  "dependencies": {
    "@dnex/ds": "workspace:*",
    "@dnex/workspace-shell": "workspace:*",
    "@supabase/supabase-js": "^2.47.0",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "packageManager": "pnpm@10.15.1"
}
